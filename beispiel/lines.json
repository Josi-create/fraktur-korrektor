{"001": {"w": 1638, "h": 2719, "lines": [{"text": "SSD G", "x0": 59, "x1": 308, "y0": 0, "y1": 101, "bl": 89, "conf": 32.7, "row": 1, "kind": "body"}, {"text": "Sed.", "x0": 105, "x1": 269, "y0": 91, "y1": 134, "bl": 134, "conf": 32.2, "row": 2, "kind": "body"}, {"text": "Faust.", "x0": 411, "x1": 1166, "y0": 338, "y1": 458, "bl": 458, "conf": 15.4, "row": 3, "kind": "body"}, {"text": "Eine Tragödie", "x0": 628, "x1": 946, "y0": 690, "y1": 744, "bl": 738, "conf": 96.2, "row": 4, "kind": "body"}, {"text": "vu", "x0": 773, "x1": 804, "y0": 989, "y1": 1007, "bl": 1007, "conf": 94.1, "row": 5, "kind": "body"}, {"text": "Gose t h,", "x0": 570, "x1": 917, "y0": 1250, "y1": 1317, "bl": 1306, "conf": 45.4, "row": 6, "kind": "body"}, {"text": "Beid Theile in Einem Bande.", "x0": 438, "x1": 1156, "y0": 1556, "y1": 1597, "bl": 1594, "conf": 93.1, "row": 7, "kind": "body"}, {"text": "Stuttgart.", "x0": 675, "x1": 899, "y0": 2110, "y1": 2168, "bl": 2168, "conf": 96.5, "row": 8, "kind": "body"}, {"text": "Cotta'scher Verlag.", "x0": 480, "x1": 1092, "y0": 2221, "y1": 2268, "bl": 2267, "conf": 87.6, "row": 9, "kind": "body"}, {"text": "1862.", "x0": 699, "x1": 850, "y0": 2324, "y1": 2366, "bl": 2366, "conf": 94.0, "row": 10, "kind": "body"}]}, "002": {"w": 1607, "h": 2709, "lines": [{"text": "Der Tragödie erster Theil.", "x0": 464, "x1": 1091, "y0": 771, "y1": 832, "bl": 827, "conf": 85.5, "row": 1, "kind": "body"}, {"text": "Nacht.", "x0": 712, "x1": 844, "y0": 902, "y1": 945, "bl": 945, "conf": 96.3, "row": 2, "kind": "body"}, {"text": "Fan", "x0": 726, "x1": 805, "y0": 1021, "y1": 1057, "bl": 1057, "conf": 95.8, "row": 3, "kind": "body"}, {"text": "(in einem hochgewölbten, engen, Ge Zimmer unruhig auf seinem", "x0": 180, "x1": 1370, "y0": 1022, "y1": 1111, "bl": 1109, "conf": 87.9, "row": 4, "kind": "body"}, {"text": "Sessel am Pulte).", "x0": 646, "x1": 919, "y0": 1117, "y1": 1150, "bl": 1148, "conf": 94.7, "row": 5, "kind": "body"}, {"text": "Habe nun, ach! Philosophie,", "x0": 182, "x1": 758, "y0": 1160, "y1": 1210, "bl": 1205, "conf": 94.7, "row": 6, "kind": "body"}, {"text": "Juristerei und Medicin,", "x0": 185, "x1": 659, "y0": 1219, "y1": 1266, "bl": 1263, "conf": 91.7, "row": 7, "kind": "body"}, {"text": "Und, leider! auch Theologie", "x0": 183, "x1": 747, "y0": 1276, "y1": 1324, "bl": 1320, "conf": 95.7, "row": 8, "kind": "body"}, {"text": "Durchaus studirt, mit heißem Bemühn.", "x0": 184, "x1": 972, "y0": 1333, "y1": 1379, "bl": 1377, "conf": 90.3, "row": 9, "kind": "body"}, {"text": "Da steh' ich nun, ich armer Thor!", "x0": 185, "x1": 889, "y0": 1391, "y1": 1437, "bl": 1435, "conf": 95.3, "row": 10, "kind": "body"}, {"text": "Und bin so klug, als wie zuvor;", "x0": 185, "x1": 852, "y0": 1449, "y1": 1500, "bl": 1489, "conf": 95.7, "row": 11, "kind": "body"}, {"text": "Heiße Magister, heiße Doctor gar,", "x0": 186, "x1": 885, "y0": 1508, "y1": 1559, "bl": 1556, "conf": 94.9, "row": 12, "kind": "body"}, {"text": "Und ziehe schon an die zehen Jahr,", "x0": 189, "x1": 913, "y0": 1565, "y1": 1616, "bl": 1611, "conf": 94.7, "row": 13, "kind": "body"}, {"text": "Herauf, herab, und quer und krumm,", "x0": 186, "x1": 960, "y0": 1625, "y1": 1674, "bl": 1666, "conf": 95.7, "row": 14, "kind": "body"}, {"text": "Meine Schüler an der Nase herum —", "x0": 191, "x1": 976, "y0": 1682, "y1": 1728, "bl": 1721, "conf": 94.5, "row": 15, "kind": "body"}, {"text": "Und sehe, daß wir nichts wissen können!", "x0": 190, "x1": 1015, "y0": 1740, "y1": 1787, "bl": 1783, "conf": 94.5, "row": 16, "kind": "body"}, {"text": "Das will mir schier das Herz verbrennen.", "x0": 191, "x1": 1035, "y0": 1798, "y1": 1847, "bl": 1838, "conf": 95.4, "row": 17, "kind": "body"}, {"text": "Zwar bin ich gescheidter als alle die Laffen,", "x0": 190, "x1": 1091, "y0": 1856, "y1": 1907, "bl": 1898, "conf": 94.8, "row": 18, "kind": "body"}, {"text": "Doctoren, Magister, Schreiber und Pfaffen;", "x0": 193, "x1": 1078, "y0": 1914, "y1": 1966, "bl": 1960, "conf": 95.0, "row": 19, "kind": "body"}, {"text": "Mich plagen keine Scrupel noch Zweifel,", "x0": 192, "x1": 1016, "y0": 1973, "y1": 2024, "bl": 2016, "conf": 95.2, "row": 20, "kind": "body"}, {"text": "Fürchte mich weder vor Hölle noch Teufel.", "x0": 195, "x1": 1052, "y0": 2030, "y1": 2081, "bl": 2074, "conf": 96.3, "row": 21, "kind": "body"}, {"text": "Dafür ist mir auch alle Freud' entrissen,", "x0": 194, "x1": 1022, "y0": 2089, "y1": 2135, "bl": 2133, "conf": 93.8, "row": 22, "kind": "body"}, {"text": "Bilde mir nicht ein, was Rechts zu wissen,", "x0": 193, "x1": 1079, "y0": 2147, "y1": 2195, "bl": 2190, "conf": 95.7, "row": 23, "kind": "body"}, {"text": "Bilde mir nicht ein, ich könnte was lehren,", "x0": 197, "x1": 1090, "y0": 2205, "y1": 2251, "bl": 2247, "conf": 96.8, "row": 24, "kind": "body"}, {"text": "Die Menschen zu bessern und zu bekehren.", "x0": 197, "x1": 1045, "y0": 2263, "y1": 2313, "bl": 2308, "conf": 94.0, "row": 25, "kind": "body"}, {"text": "Auch hab' ich weder Gut noch Geld,", "x0": 197, "x1": 942, "y0": 2321, "y1": 2369, "bl": 2366, "conf": 96.6, "row": 26, "kind": "body"}, {"text": "Goethe, Faust. 2", "x0": 274, "x1": 1178, "y0": 2392, "y1": 2425, "bl": 2425, "conf": 91.9, "row": 27, "kind": "body"}]}, "003": {"w": 1623, "h": 2704, "lines": [{"text": "3", "x0": 1452, "x1": 1513, "y0": 0, "y1": 16, "bl": 16, "conf": 29.4, "row": 1, "kind": "head"}, {"text": "18", "x0": 774, "x1": 828, "y0": 152, "y1": 194, "bl": 194, "conf": 96.6, "row": 2, "kind": "body"}, {"text": "Noch Ehr' und Herrlichkeit der Welt;", "x0": 208, "x1": 957, "y0": 305, "y1": 353, "bl": 349, "conf": 95.0, "row": 3, "kind": "body"}, {"text": "Es möchte kein Hund so länger leben!", "x0": 207, "x1": 980, "y0": 362, "y1": 411, "bl": 408, "conf": 95.6, "row": 4, "kind": "body"}, {"text": "Drum hab' ich mich der Magie ergeben,", "x0": 206, "x1": 1027, "y0": 420, "y1": 469, "bl": 465, "conf": 96.5, "row": 5, "kind": "body"}, {"text": "Ob mir durch Geistes Kraft und Mund", "x0": 206, "x1": 1006, "y0": 478, "y1": 524, "bl": 519, "conf": 95.3, "row": 6, "kind": "body"}, {"text": "Nicht mein Geheimniß würde kund!", "x0": 207, "x1": 920, "y0": 537, "y1": 582, "bl": 575, "conf": 95.0, "row": 7, "kind": "body"}, {"text": "Daß ich nicht mehr, mit sauerm Schweiß,", "x0": 207, "x1": 1062, "y0": 594, "y1": 640, "bl": 640, "conf": 95.4, "row": 8, "kind": "body"}, {"text": "Zu sagen brauche, was ich nicht weiß,", "x0": 206, "x1": 991, "y0": 652, "y1": 700, "bl": 697, "conf": 95.7, "row": 9, "kind": "body"}, {"text": "Daß ich erkenne, was die Welt", "x0": 206, "x1": 841, "y0": 702, "y1": 755, "bl": 751, "conf": 96.8, "row": 10, "kind": "body"}, {"text": "Im Innersten zusammenhält,", "x0": 207, "x1": 791, "y0": 767, "y1": 815, "bl": 814, "conf": 92.2, "row": 11, "kind": "body"}, {"text": "Schau' alle Wirkenskraft und Samen,", "x0": 207, "x1": 966, "y0": 826, "y1": 872, "bl": 870, "conf": 94.5, "row": 12, "kind": "body"}, {"text": "Und thu' nicht mehr in Worten kramen!", "x0": 207, "x1": 1027, "y0": 884, "y1": 930, "bl": 923, "conf": 94.0, "row": 13, "kind": "body"}, {"text": "O sähst du, voller Mondenschein!", "x0": 206, "x1": 878, "y0": 1000, "y1": 1046, "bl": 1044, "conf": 93.0, "row": 14, "kind": "body"}, {"text": "Zum letztenmal auf meine Pein,", "x0": 205, "x1": 860, "y0": 1059, "y1": 1105, "bl": 1104, "conf": 94.7, "row": 15, "kind": "body"}, {"text": "Den ich so manche Mitternacht", "x0": 206, "x1": 829, "y0": 1116, "y1": 1163, "bl": 1160, "conf": 94.8, "row": 16, "kind": "body"}, {"text": "An diesem Pult herangewacht!", "x0": 206, "x1": 816, "y0": 1175, "y1": 1225, "bl": 1220, "conf": 92.7, "row": 17, "kind": "body"}, {"text": "Dann über Büchern und Papier,", "x0": 207, "x1": 876, "y0": 1232, "y1": 1279, "bl": 1271, "conf": 96.6, "row": 18, "kind": "body"}, {"text": "Trübsel'ger Freund! erschienst du mir.", "x0": 207, "x1": 967, "y0": 1290, "y1": 1338, "bl": 1336, "conf": 94.2, "row": 19, "kind": "body"}, {"text": "Ach, könnt' ich doch auf Bergeshöh'n", "x0": 207, "x1": 950, "y0": 1348, "y1": 1399, "bl": 1392, "conf": 95.4, "row": 20, "kind": "body"}, {"text": "In deinem lieben Lichte gehn,", "x0": 208, "x1": 816, "y0": 1406, "y1": 1455, "bl": 1450, "conf": 96.7, "row": 21, "kind": "body"}, {"text": "Um Bergeshöhle mit Geistern schweben,", "x0": 207, "x1": 1009, "y0": 1463, "y1": 1512, "bl": 1510, "conf": 92.7, "row": 22, "kind": "body"}, {"text": "Auf Wiesen in deinem Dämmer weben,", "x0": 204, "x1": 1019, "y0": 1520, "y1": 1568, "bl": 1564, "conf": 95.2, "row": 23, "kind": "body"}, {"text": "Von allem Wissensqualm entladen,", "x0": 205, "x1": 909, "y0": 1578, "y1": 1627, "bl": 1621, "conf": 94.5, "row": 24, "kind": "body"}, {"text": "In deinem Thau gesund mich baden!", "x0": 206, "x1": 955, "y0": 1637, "y1": 1688, "bl": 1682, "conf": 95.6, "row": 25, "kind": "body"}, {"text": "Weh! steck' ich in dem Kerker noch?", "x0": 206, "x1": 930, "y0": 1753, "y1": 1799, "bl": 1798, "conf": 95.2, "row": 26, "kind": "body"}, {"text": "Verfluchtes, dumpfes Mauerloch,", "x0": 205, "x1": 857, "y0": 1812, "y1": 1859, "bl": 1859, "conf": 92.0, "row": 27, "kind": "body"}, {"text": "Wo selbst das liebe Himmelslicht", "x0": 206, "x1": 864, "y0": 1870, "y1": 1919, "bl": 1909, "conf": 93.4, "row": 28, "kind": "body"}, {"text": "Trüb durch gemalte Scheiben bricht!", "x0": 205, "x1": 932, "y0": 1928, "y1": 1977, "bl": 1973, "conf": 95.9, "row": 29, "kind": "body"}, {"text": "Beschränkt mit diesem Bücherhauf,", "x0": 206, "x1": 890, "y0": 1986, "y1": 2033, "bl": 2032, "conf": 92.6, "row": 30, "kind": "body"}, {"text": "Den Würmer nagen „Staub bedeckt,", "x0": 206, "x1": 938, "y0": 2035, "y1": 2094, "bl": 2088, "conf": 95.9, "row": 31, "kind": "body"}, {"text": "Den, bis an's hohe Gewölb' hinauf,", "x0": 205, "x1": 942, "y0": 2103, "y1": 2147, "bl": 2144, "conf": 95.3, "row": 32, "kind": "body"}, {"text": "Ein angeraucht Papier umsteckt!", "x0": 207, "x1": 839, "y0": 2160, "y1": 2209, "bl": 2204, "conf": 90.6, "row": 33, "kind": "body"}, {"text": "Mit Gläsern, Büchsen rings umstellt,", "x0": 207, "x1": 965, "y0": 2218, "y1": 2269, "bl": 2264, "conf": 91.4, "row": 34, "kind": "body"}, {"text": "Mit Instrumenten vollgepfropft,", "x0": 206, "x1": 842, "y0": 2276, "y1": 2327, "bl": 2323, "conf": 92.4, "row": 35, "kind": "body"}]}, "004": {"w": 1607, "h": 2709, "lines": [{"text": "19", "x0": 759, "x1": 811, "y0": 185, "y1": 225, "bl": 225, "conf": 96.4, "row": 1, "kind": "head"}, {"text": "Urväter Hausrath dreingestopft —", "x0": 180, "x1": 867, "y0": 333, "y1": 383, "bl": 377, "conf": 92.6, "row": 2, "kind": "body"}, {"text": "Das ist deine Welt! das heißt eine Welt!", "x0": 179, "x1": 1023, "y0": 392, "y1": 437, "bl": 432, "conf": 95.8, "row": 3, "kind": "body"}, {"text": "Und fragst du noch, warum dein Herz", "x0": 181, "x1": 960, "y0": 503, "y1": 553, "bl": 542, "conf": 95.0, "row": 4, "kind": "body"}, {"text": "Sich bang in deinem Busen klemmt,", "x0": 181, "x1": 922, "y0": 561, "y1": 609, "bl": 604, "conf": 95.3, "row": 5, "kind": "body"}, {"text": "Warum ein unerklärter Schmerz", "x0": 179, "x1": 826, "y0": 619, "y1": 668, "bl": 657, "conf": 94.9, "row": 6, "kind": "body"}, {"text": "Dir alle Lebensregung hemmt?", "x0": 177, "x1": 799, "y0": 677, "y1": 726, "bl": 716, "conf": 94.7, "row": 7, "kind": "body"}, {"text": "Statt der lebendigen Natur,", "x0": 178, "x1": 741, "y0": 736, "y1": 784, "bl": 777, "conf": 96.3, "row": 8, "kind": "body"}, {"text": "Da Gott die Menschen schuf hinein,", "x0": 177, "x1": 903, "y0": 794, "y1": 840, "bl": 835, "conf": 94.7, "row": 9, "kind": "body"}, {"text": "Umgibt in Rauch und Moder nur", "x0": 178, "x1": 863, "y0": 852, "y1": 902, "bl": 891, "conf": 96.0, "row": 10, "kind": "body"}, {"text": "Dich Thiergeripp' und Todtenbein.", "x0": 177, "x1": 858, "y0": 911, "y1": 960, "bl": 952, "conf": 91.8, "row": 11, "kind": "body"}, {"text": "Flieh'! Auf! Hinaus in's weite Land!", "x0": 178, "x1": 946, "y0": 1027, "y1": 1075, "bl": 1069, "conf": 96.0, "row": 12, "kind": "body"}, {"text": "Und dies geheimnißvolle Buch,", "x0": 177, "x1": 797, "y0": 1086, "y1": 1135, "bl": 1127, "conf": 94.6, "row": 13, "kind": "body"}, {"text": "Von Nostradamus' eigner Hand,", "x0": 177, "x1": 830, "y0": 1144, "y1": 1193, "bl": 1191, "conf": 94.6, "row": 14, "kind": "body"}, {"text": "Ist dir es nicht Geleit genug?", "x0": 177, "x1": 799, "y0": 1202, "y1": 1252, "bl": 1244, "conf": 96.0, "row": 15, "kind": "body"}, {"text": "Erkennest dann der Sterne Lauf,", "x0": 176, "x1": 839, "y0": 1260, "y1": 1307, "bl": 1298, "conf": 95.8, "row": 16, "kind": "body"}, {"text": "Und wenn Natur dich unterweist,", "x0": 173, "x1": 852, "y0": 1319, "y1": 1364, "bl": 1358, "conf": 93.5, "row": 17, "kind": "body"}, {"text": "Dann geht die Seelenkraft dir auf,", "x0": 175, "x1": 889, "y0": 1377, "y1": 1427, "bl": 1418, "conf": 95.3, "row": 18, "kind": "body"}, {"text": "Wie spricht ein Geist zum andern Geist.", "x0": 172, "x1": 987, "y0": 1435, "y1": 1484, "bl": 1480, "conf": 92.7, "row": 19, "kind": "body"}, {"text": "Umsonst, daß trocknes Sinnen hier", "x0": 172, "x1": 875, "y0": 1494, "y1": 1540, "bl": 1532, "conf": 94.2, "row": 20, "kind": "body"}, {"text": "Die heil'gen Zeichen dir erklärt:", "x0": 175, "x1": 818, "y0": 1553, "y1": 1602, "bl": 1591, "conf": 95.2, "row": 21, "kind": "body"}, {"text": "Ihr schwebt, ihr Geister, neben mir;", "x0": 175, "x1": 923, "y0": 1611, "y1": 1658, "bl": 1656, "conf": 93.8, "row": 22, "kind": "body"}, {"text": "Antwortet mir, wenn ihr mich hört!", "x0": 173, "x1": 914, "y0": 1669, "y1": 1715, "bl": 1714, "conf": 96.5, "row": 23, "kind": "body"}, {"text": "(Er schlägt das Buch auf, und erblickt das Zeichen des Makrokosmus.)", "x0": 202, "x1": 1338, "y0": 1738, "y1": 1774, "bl": 1766, "conf": 93.6, "row": 24, "kind": "body"}, {"text": "Ha! welche Wonne fließt in diesem Blick", "x0": 173, "x1": 995, "y0": 1792, "y1": 1846, "bl": 1837, "conf": 95.7, "row": 25, "kind": "body"}, {"text": "Auf einmal mir durch alle meine Sinnen!", "x0": 173, "x1": 1032, "y0": 1850, "y1": 1896, "bl": 1888, "conf": 96.6, "row": 26, "kind": "body"}, {"text": "Ich fühle junges, heil'ges Lebensglück", "x0": 173, "x1": 931, "y0": 1908, "y1": 1957, "bl": 1957, "conf": 94.9, "row": 27, "kind": "body"}, {"text": "Neuglühend mir durch Nerv' und Adern rinnen.", "x0": 173, "x1": 1144, "y0": 1966, "y1": 2016, "bl": 2004, "conf": 94.4, "row": 28, "kind": "body"}, {"text": "War es ein Gott, der diese Zeichen schrieb,", "x0": 173, "x1": 1059, "y0": 2021, "y1": 2076, "bl": 2070, "conf": 94.8, "row": 29, "kind": "body"}, {"text": "Die mir das inn're Toben stillen,", "x0": 173, "x1": 860, "y0": 2083, "y1": 2127, "bl": 2122, "conf": 93.6, "row": 30, "kind": "body"}, {"text": "Das arme Herz mit Freude füllen,", "x0": 173, "x1": 884, "y0": 2142, "y1": 2190, "bl": 2184, "conf": 96.4, "row": 31, "kind": "body"}, {"text": "Und, mit geheimnißvollem Trieb,", "x0": 172, "x1": 848, "y0": 2200, "y1": 2249, "bl": 2245, "conf": 94.8, "row": 32, "kind": "body"}, {"text": "Die Kräfte der Natur rings um mich her enthüllen?", "x0": 171, "x1": 1235, "y0": 2255, "y1": 2308, "bl": 2300, "conf": 96.6, "row": 33, "kind": "body"}, {"text": "Bin ich ein Gott? Mir wird so licht!", "x0": 172, "x1": 938, "y0": 2312, "y1": 2366, "bl": 2355, "conf": 95.9, "row": 34, "kind": "body"}]}, "005": {"w": 1623, "h": 2704, "lines": [{"text": "0", "x0": 1544, "x1": 1564, "y0": 2, "y1": 28, "bl": 28, "conf": 27.6, "row": 1, "kind": "head"}, {"text": ".", "x0": 1531, "x1": 1540, "y0": 21, "y1": 63, "bl": 63, "conf": 48.5, "row": 2, "kind": "body"}, {"text": "20", "x0": 765, "x1": 823, "y0": 168, "y1": 209, "bl": 209, "conf": 96.5, "row": 3, "kind": "body"}, {"text": "Ich schau' in diesen reinen Zügen", "x0": 198, "x1": 877, "y0": 320, "y1": 369, "bl": 366, "conf": 94.1, "row": 4, "kind": "body"}, {"text": "Die wirkende Natur vor meiner Seele liegen.", "x0": 202, "x1": 1117, "y0": 378, "y1": 427, "bl": 417, "conf": 95.9, "row": 5, "kind": "body"}, {"text": "Jetzt erst erkenn' ich, was der Weise spricht:", "x0": 199, "x1": 1097, "y0": 437, "y1": 485, "bl": 481, "conf": 93.7, "row": 6, "kind": "body"}, {"text": "„Die Geisterwelt ist nicht verschlossen;", "x0": 201, "x1": 959, "y0": 495, "y1": 544, "bl": 539, "conf": 93.0, "row": 7, "kind": "body"}, {"text": "Dein Sinn ist zu, dein Herz ist todt!", "x0": 199, "x1": 966, "y0": 553, "y1": 602, "bl": 594, "conf": 94.5, "row": 8, "kind": "body"}, {"text": "Auf! bade, Schüler, unverdrossen", "x0": 200, "x1": 878, "y0": 611, "y1": 658, "bl": 656, "conf": 94.6, "row": 9, "kind": "body"}, {"text": "Die ird'sche Brust im Morgenroth!“", "x0": 200, "x1": 928, "y0": 669, "y1": 718, "bl": 713, "conf": 94.0, "row": 10, "kind": "body"}, {"text": "(Er beschaut das Zeichen.)", "x0": 597, "x1": 1007, "y0": 734, "y1": 768, "bl": 763, "conf": 94.4, "row": 11, "kind": "body"}, {"text": "Wie alles sich zum Ganzen webt,", "x0": 200, "x1": 876, "y0": 781, "y1": 829, "bl": 824, "conf": 95.3, "row": 12, "kind": "body"}, {"text": "Eins in dem andern wirkt und lebt!", "x0": 204, "x1": 947, "y0": 839, "y1": 879, "bl": 877, "conf": 96.9, "row": 13, "kind": "body"}, {"text": "Wie Himmelskräfte auf- und niedersteigen", "x0": 201, "x1": 1043, "y0": 897, "y1": 947, "bl": 940, "conf": 92.5, "row": 14, "kind": "body"}, {"text": "Und sich die goldnen Eimer reichen,", "x0": 201, "x1": 931, "y0": 956, "y1": 1005, "bl": 997, "conf": 95.2, "row": 15, "kind": "body"}, {"text": "Mit segenduftenden Schwingen", "x0": 207, "x1": 816, "y0": 1015, "y1": 1065, "bl": 1063, "conf": 94.1, "row": 16, "kind": "body"}, {"text": "Vom Himmel durch die Erde dringen,", "x0": 203, "x1": 978, "y0": 1073, "y1": 1122, "bl": 1115, "conf": 96.6, "row": 17, "kind": "body"}, {"text": "Harmonisch all das All durchklingen!", "x0": 201, "x1": 947, "y0": 1131, "y1": 1181, "bl": 1169, "conf": 94.6, "row": 18, "kind": "body"}, {"text": "Welch Schauspiel! aber ach! ein Schauspiel nur!", "x0": 203, "x1": 1181, "y0": 1242, "y1": 1289, "bl": 1287, "conf": 94.0, "row": 19, "kind": "body"}, {"text": "Wo fass' ich dich, unendliche Natur?", "x0": 204, "x1": 948, "y0": 1301, "y1": 1346, "bl": 1345, "conf": 92.9, "row": 20, "kind": "body"}, {"text": "Euch, Brüste, wo? Ihr Quellen alles Lebens,", "x0": 205, "x1": 1144, "y0": 1359, "y1": 1406, "bl": 1402, "conf": 95.6, "row": 21, "kind": "body"}, {"text": "An denen Himmel und Erde hängt,", "x0": 203, "x1": 938, "y0": 1419, "y1": 1465, "bl": 1456, "conf": 96.4, "row": 22, "kind": "body"}, {"text": "Dahin die welke Brust sich drängt —", "x0": 203, "x1": 970, "y0": 1477, "y1": 1526, "bl": 1522, "conf": 93.1, "row": 23, "kind": "body"}, {"text": "Ihr quellt, ihr tränkt, und schmacht' ich so vergebens?", "x0": 204, "x1": 1326, "y0": 1534, "y1": 1583, "bl": 1580, "conf": 93.5, "row": 24, "kind": "body"}, {"text": "(Er schlägt unwillig das Buch um, und erblickt das Zeichen des Erdgeistes.)", "x0": 204, "x1": 1399, "y0": 1601, "y1": 1640, "bl": 1634, "conf": 95.3, "row": 25, "kind": "body"}, {"text": "Wie anders wirkt dies Zeichen auf mich ein!", "x0": 205, "x1": 1118, "y0": 1657, "y1": 1701, "bl": 1697, "conf": 96.3, "row": 26, "kind": "body"}, {"text": "Du, Geist der Erde, bist mir näher;", "x0": 205, "x1": 960, "y0": 1716, "y1": 1761, "bl": 1760, "conf": 94.4, "row": 27, "kind": "body"}, {"text": "Schon fühl' ich meine Kräfte höher,", "x0": 208, "x1": 935, "y0": 1775, "y1": 1821, "bl": 1819, "conf": 95.4, "row": 28, "kind": "body"}, {"text": "Schon glüh' ich wie von neuem Wein;", "x0": 206, "x1": 996, "y0": 1833, "y1": 1883, "bl": 1877, "conf": 95.0, "row": 29, "kind": "body"}, {"text": "Ich fühle Muth, mich in die Welt zu wagen,", "x0": 206, "x1": 1146, "y0": 1892, "y1": 1941, "bl": 1937, "conf": 96.7, "row": 30, "kind": "body"}, {"text": "Der Erde Weh, der Erde Glück zu tragen,", "x0": 206, "x1": 1081, "y0": 1950, "y1": 1999, "bl": 1989, "conf": 96.5, "row": 31, "kind": "body"}, {"text": "Mit Stürmen mich herumzuschlagen,", "x0": 206, "x1": 938, "y0": 2008, "y1": 2057, "bl": 2049, "conf": 94.5, "row": 32, "kind": "body"}, {"text": "Und in des Schiffbruchs Knirschen nicht zu zagen.", "x0": 207, "x1": 1223, "y0": 2067, "y1": 2116, "bl": 2111, "conf": 94.3, "row": 33, "kind": "body"}, {"text": "Es wölkt sich über mir —", "x0": 207, "x1": 747, "y0": 2126, "y1": 2169, "bl": 2163, "conf": 93.6, "row": 34, "kind": "body"}, {"text": "Der Mond verbirgt sein Licht —", "x0": 205, "x1": 888, "y0": 2183, "y1": 2232, "bl": 2225, "conf": 94.0, "row": 35, "kind": "body"}, {"text": "Die Lampe schwindet! —", "x0": 207, "x1": 725, "y0": 2242, "y1": 2288, "bl": 2283, "conf": 93.5, "row": 36, "kind": "body"}, {"text": "Es dampft! — Es zucken rothe Strahlen", "x0": 209, "x1": 1041, "y0": 2301, "y1": 2350, "bl": 2345, "conf": 95.2, "row": 37, "kind": "body"}]}, "006": {"w": 1602, "h": 2714, "lines": [{"text": "Trüber Tag.", "x0": 651, "x1": 941, "y0": 471, "y1": 515, "bl": 511, "conf": 93.8, "row": 1, "kind": "body"}, {"text": "Feld.", "x0": 745, "x1": 854, "y0": 564, "y1": 609, "bl": 609, "conf": 96.8, "row": 2, "kind": "body"}, {"text": "Faust. Mephistopheles.", "x0": 562, "x1": 1042, "y0": 656, "y1": 691, "bl": 691, "conf": 90.8, "row": 3, "kind": "body"}, {"text": "Faust.", "x0": 736, "x1": 863, "y0": 742, "y1": 785, "bl": 785, "conf": 91.9, "row": 4, "kind": "body"}, {"text": "Im Elend! Verzweifelnd! Erbärmlich auf der Erde lange", "x0": 274, "x1": 1401, "y0": 797, "y1": 848, "bl": 842, "conf": 95.1, "row": 5, "kind": "body"}, {"text": "verirrt und nun gefangen! Als Missethäterin im Kerker zu", "x0": 197, "x1": 1403, "y0": 855, "y1": 907, "bl": 896, "conf": 95.1, "row": 6, "kind": "body"}, {"text": "entsetzlichen Qualen eingesperrt, das holde, unselige Geschöpf!", "x0": 196, "x1": 1401, "y0": 914, "y1": 965, "bl": 961, "conf": 93.5, "row": 7, "kind": "body"}, {"text": "Bis dahin! dahin! — Verrätherischer, nichtswürdiger Geist,", "x0": 196, "x1": 1400, "y0": 971, "y1": 1023, "bl": 1020, "conf": 87.2, "row": 8, "kind": "body"}, {"text": "und das hast du mir verheimlicht! — Steh' nur, steh'!", "x0": 195, "x1": 1398, "y0": 1031, "y1": 1079, "bl": 1074, "conf": 94.2, "row": 9, "kind": "body"}, {"text": "Wälze die teuflischen Augen ingrimmend im Kopf herum!", "x0": 196, "x1": 1401, "y0": 1089, "y1": 1141, "bl": 1136, "conf": 94.1, "row": 10, "kind": "body"}, {"text": "Steh' und trutze mir durch deine unerträgliche Gegenwart!", "x0": 197, "x1": 1402, "y0": 1147, "y1": 1198, "bl": 1195, "conf": 95.9, "row": 11, "kind": "body"}, {"text": "Gefangen! Im unwiederbringlichen Elend! Bösen Geistern", "x0": 204, "x1": 1405, "y0": 1206, "y1": 1259, "bl": 1254, "conf": 92.8, "row": 12, "kind": "body"}, {"text": "übergeben und der richtenden gefühllosen Menschheit! Und", "x0": 203, "x1": 1405, "y0": 1265, "y1": 1318, "bl": 1311, "conf": 94.5, "row": 13, "kind": "body"}, {"text": "mich wiegst du indeß in abgeschmackten Zerstreuungen, ver¬", "x0": 203, "x1": 1406, "y0": 1324, "y1": 1375, "bl": 1370, "conf": 86.5, "row": 14, "kind": "body"}, {"text": "birgst mir ihren wachsenden Jammer, und lässest sie hülflos", "x0": 203, "x1": 1407, "y0": 1382, "y1": 1434, "bl": 1428, "conf": 93.3, "row": 15, "kind": "body"}, {"text": "verderben!", "x0": 203, "x1": 416, "y0": 1437, "y1": 1481, "bl": 1481, "conf": 91.7, "row": 16, "kind": "body"}, {"text": "Mephistopheles.", "x0": 625, "x1": 981, "y0": 1503, "y1": 1547, "bl": 1547, "conf": 89.4, "row": 17, "kind": "body"}, {"text": "Sie ist die erste nicht.", "x0": 283, "x1": 727, "y0": 1558, "y1": 1604, "bl": 1602, "conf": 93.8, "row": 18, "kind": "body"}, {"text": "Faust.", "x0": 739, "x1": 864, "y0": 1619, "y1": 1661, "bl": 1661, "conf": 91.0, "row": 19, "kind": "body"}, {"text": "Hund! abscheuliches Unthier! — Wandle ihn, du unend¬", "x0": 282, "x1": 1408, "y0": 1675, "y1": 1724, "bl": 1716, "conf": 92.6, "row": 20, "kind": "body"}, {"text": "licher Geist! wandle den Wurm wieder in seine Hundsge¬", "x0": 203, "x1": 1408, "y0": 1733, "y1": 1782, "bl": 1772, "conf": 92.9, "row": 21, "kind": "body"}, {"text": "stalt, wie er sich oft nächtlicher Weise gefiel, vor mir her¬", "x0": 203, "x1": 1409, "y0": 1792, "y1": 1841, "bl": 1837, "conf": 94.2, "row": 22, "kind": "body"}, {"text": "zutrotten, dem harmlosen Wanderer vor die Füße zu kollern", "x0": 203, "x1": 1410, "y0": 1850, "y1": 1899, "bl": 1889, "conf": 94.4, "row": 23, "kind": "body"}, {"text": "und sich dem niederstürzenden auf die Schultern zu hängen!", "x0": 204, "x1": 1405, "y0": 1908, "y1": 1958, "bl": 1954, "conf": 95.0, "row": 24, "kind": "body"}, {"text": "Wandl' ihn wieder in seine Lieblingsbildung, daß er vor", "x0": 204, "x1": 1410, "y0": 1967, "y1": 2017, "bl": 2006, "conf": 94.6, "row": 25, "kind": "body"}, {"text": "mir im Sand auf dem Bauch krieche, ich ihn mit Füßen", "x0": 204, "x1": 1411, "y0": 2025, "y1": 2072, "bl": 2070, "conf": 96.5, "row": 26, "kind": "body"}, {"text": "trete, den Verworfenen! — Die erste nicht! — Jammer!", "x0": 204, "x1": 1408, "y0": 2084, "y1": 2131, "bl": 2130, "conf": 92.9, "row": 27, "kind": "body"}, {"text": "Jammer! von keiner Menschenseele zu fassen, daß mehr als", "x0": 203, "x1": 1411, "y0": 2142, "y1": 2192, "bl": 2188, "conf": 94.1, "row": 28, "kind": "body"}, {"text": "Ein Geschöpf in die Tiefe dieses Elendes versank, daß nicht", "x0": 204, "x1": 1412, "y0": 2201, "y1": 2249, "bl": 2246, "conf": 94.5, "row": 29, "kind": "body"}, {"text": "das erste genugthat für die Schuld aller übrigen, in seiner", "x0": 205, "x1": 1412, "y0": 2259, "y1": 2310, "bl": 2305, "conf": 94.7, "row": 30, "kind": "body"}]}, "007": {"w": 1576, "h": 2699, "lines": [{"text": "175", "x0": 670, "x1": 753, "y0": 154, "y1": 195, "bl": 195, "conf": 95.7, "row": 1, "kind": "head"}, {"text": "windenden Todesnoth vor den Augen des ewig Verzeihen¬", "x0": 109, "x1": 1303, "y0": 301, "y1": 352, "bl": 345, "conf": 94.5, "row": 2, "kind": "body"}, {"text": "den! Mir wühlt es Mark und Leben durch, das Elend", "x0": 108, "x1": 1303, "y0": 359, "y1": 406, "bl": 400, "conf": 96.5, "row": 3, "kind": "body"}, {"text": "dieser einzigen; du grinsest gelassen über das Schicksal von", "x0": 107, "x1": 1304, "y0": 417, "y1": 470, "bl": 464, "conf": 94.0, "row": 4, "kind": "body"}, {"text": "Tausenden hin!", "x0": 106, "x1": 406, "y0": 479, "y1": 522, "bl": 521, "conf": 94.5, "row": 5, "kind": "body"}, {"text": "Mephistopheles.", "x0": 523, "x1": 885, "y0": 556, "y1": 598, "bl": 598, "conf": 90.1, "row": 6, "kind": "body"}, {"text": "Nun sind wir schon wieder an der Grenze unseres", "x0": 184, "x1": 1304, "y0": 614, "y1": 663, "bl": 655, "conf": 94.0, "row": 7, "kind": "body"}, {"text": "Witzes, da wo euch Menschen der Sinn überschnappt.", "x0": 105, "x1": 1303, "y0": 672, "y1": 721, "bl": 714, "conf": 93.4, "row": 8, "kind": "body"}, {"text": "Warum machst du Gemeinschaft mit uns, wenn du sie", "x0": 105, "x1": 1304, "y0": 731, "y1": 777, "bl": 771, "conf": 93.9, "row": 9, "kind": "body"}, {"text": "nicht durchführen kannst? Willst fliegen und bist vor'm", "x0": 104, "x1": 1304, "y0": 788, "y1": 837, "bl": 833, "conf": 93.3, "row": 10, "kind": "body"}, {"text": "Schwindel nicht sicher? Drangen wir uns dir auf, oder du", "x0": 104, "x1": 1304, "y0": 847, "y1": 898, "bl": 888, "conf": 95.6, "row": 11, "kind": "body"}, {"text": "dich uns?", "x0": 104, "x1": 291, "y0": 907, "y1": 951, "bl": 947, "conf": 96.7, "row": 12, "kind": "body"}, {"text": "Faust.", "x0": 642, "x1": 766, "y0": 979, "y1": 1015, "bl": 1015, "conf": 88.4, "row": 13, "kind": "body"}, {"text": "Fletsche deine gefräßigen Zähne mir nicht so entgegen!", "x0": 183, "x1": 1302, "y0": 1037, "y1": 1089, "bl": 1084, "conf": 94.4, "row": 14, "kind": "body"}, {"text": "Mir ekelt's! — Großer, herrlicher Geist, der du mir zu", "x0": 103, "x1": 1303, "y0": 1095, "y1": 1142, "bl": 1136, "conf": 94.7, "row": 15, "kind": "body"}, {"text": "erscheinen würdigtest, der du mein Herz kennest und meine", "x0": 104, "x1": 1302, "y0": 1153, "y1": 1205, "bl": 1193, "conf": 94.9, "row": 16, "kind": "body"}, {"text": "Seele, warum an den Schandgesellen mich schmieden, der", "x0": 105, "x1": 1304, "y0": 1212, "y1": 1261, "bl": 1254, "conf": 94.4, "row": 17, "kind": "body"}, {"text": "sich am Schaden weidet und an Verderben sich letzt?", "x0": 104, "x1": 1171, "y0": 1270, "y1": 1317, "bl": 1310, "conf": 94.6, "row": 18, "kind": "body"}, {"text": "Mephistopheles.", "x0": 515, "x1": 878, "y0": 1350, "y1": 1390, "bl": 1390, "conf": 87.4, "row": 19, "kind": "body"}, {"text": "Endigst du?", "x0": 185, "x1": 419, "y0": 1406, "y1": 1456, "bl": 1449, "conf": 94.9, "row": 20, "kind": "body"}, {"text": "Faust.", "x0": 637, "x1": 764, "y0": 1477, "y1": 1514, "bl": 1514, "conf": 84.5, "row": 21, "kind": "body"}, {"text": "Rette sie! oder weh dir! Den gräßlichsten Fluch über", "x0": 183, "x1": 1298, "y0": 1535, "y1": 1586, "bl": 1578, "conf": 95.0, "row": 22, "kind": "body"}, {"text": "dich auf Jahrtausende.", "x0": 104, "x1": 547, "y0": 1597, "y1": 1644, "bl": 1642, "conf": 94.3, "row": 23, "kind": "body"}, {"text": "Mephistopheles.", "x0": 521, "x1": 874, "y0": 1674, "y1": 1715, "bl": 1715, "conf": 85.8, "row": 24, "kind": "body"}, {"text": "Ich kann die Bande des Rächers nicht lösen, seine", "x0": 182, "x1": 1299, "y0": 1733, "y1": 1783, "bl": 1778, "conf": 94.4, "row": 25, "kind": "body"}, {"text": "Riegel nicht öffnen. — Rette sie! — Wer war's, der sie", "x0": 104, "x1": 1298, "y0": 1791, "y1": 1845, "bl": 1834, "conf": 94.2, "row": 26, "kind": "body"}, {"text": "in's Verderben stürzte? Ich oder du?", "x0": 103, "x1": 860, "y0": 1851, "y1": 1901, "bl": 1891, "conf": 95.6, "row": 27, "kind": "body"}, {"text": "(Faust blickt wild umher.)", "x0": 498, "x1": 904, "y0": 1912, "y1": 1948, "bl": 1943, "conf": 95.3, "row": 28, "kind": "body"}, {"text": "Greifst du nach dem Donner? Wohl, daß er euch elen¬", "x0": 183, "x1": 1298, "y0": 1953, "y1": 2012, "bl": 2002, "conf": 95.4, "row": 29, "kind": "body"}, {"text": "den Sterblichen nicht gegeben ward! Den unschuldig Ent¬", "x0": 103, "x1": 1298, "y0": 2016, "y1": 2070, "bl": 2062, "conf": 95.0, "row": 30, "kind": "body"}, {"text": "gegnenden zu zerschmettern, das ist so Tyrannenart, sich", "x0": 104, "x1": 1300, "y0": 2070, "y1": 2130, "bl": 2121, "conf": 92.6, "row": 31, "kind": "body"}, {"text": "in Verlegenheiten Luft zu machen.", "x0": 104, "x1": 790, "y0": 2137, "y1": 2187, "bl": 2182, "conf": 95.1, "row": 32, "kind": "body"}, {"text": "Faust.", "x0": 637, "x1": 760, "y0": 2213, "y1": 2256, "bl": 2256, "conf": 89.3, "row": 33, "kind": "body"}, {"text": "Bringe mich hin! Sie soll frei seyn!", "x0": 184, "x1": 922, "y0": 2273, "y1": 2325, "bl": 2320, "conf": 94.6, "row": 34, "kind": "body"}]}, "008": {"w": 1602, "h": 2714, "lines": [{"text": "176", "x0": 810, "x1": 891, "y0": 153, "y1": 194, "bl": 194, "conf": 96.4, "row": 1, "kind": "head"}, {"text": "Mephistopheles.", "x0": 672, "x1": 1024, "y0": 305, "y1": 351, "bl": 351, "conf": 89.3, "row": 2, "kind": "body"}, {"text": "Und die Gefahr, der du dich aussetzest? Wisse, noch", "x0": 329, "x1": 1447, "y0": 362, "y1": 410, "bl": 406, "conf": 94.9, "row": 3, "kind": "body"}, {"text": "liegt auf der Stadt Blutschuld von deiner Hand. Ueber des", "x0": 249, "x1": 1448, "y0": 421, "y1": 472, "bl": 460, "conf": 95.8, "row": 4, "kind": "body"}, {"text": "Erschlagenen Stätte schweben rächende Geister und lauern", "x0": 250, "x1": 1448, "y0": 479, "y1": 530, "bl": 524, "conf": 93.8, "row": 5, "kind": "body"}, {"text": "auf den wiederkehrenden Mörder.", "x0": 249, "x1": 913, "y0": 538, "y1": 584, "bl": 580, "conf": 95.8, "row": 6, "kind": "body"}, {"text": "Faust.", "x0": 785, "x1": 909, "y0": 617, "y1": 661, "bl": 661, "conf": 87.8, "row": 7, "kind": "body"}, {"text": "Noch das von dir? Mord und Tod einer Welt über", "x0": 328, "x1": 1448, "y0": 677, "y1": 723, "bl": 716, "conf": 96.4, "row": 8, "kind": "body"}, {"text": "dich Ungeheuer! Führe mich hin, sag' ich, und befrei' sie!", "x0": 249, "x1": 1447, "y0": 735, "y1": 787, "bl": 781, "conf": 94.5, "row": 9, "kind": "body"}, {"text": "Mephistopheles.", "x0": 671, "x1": 1024, "y0": 815, "y1": 857, "bl": 857, "conf": 90.5, "row": 10, "kind": "body"}, {"text": "Ich führe dich, und was ich thun kann, höre! Habe", "x0": 328, "x1": 1447, "y0": 875, "y1": 925, "bl": 919, "conf": 96.5, "row": 11, "kind": "body"}, {"text": "ich alle Macht im Himmel und auf Erden? Des Thürmers", "x0": 250, "x1": 1449, "y0": 934, "y1": 983, "bl": 975, "conf": 95.6, "row": 12, "kind": "body"}, {"text": "Sinne will ich umnebeln; bemächtige dich der Schlüssel, und", "x0": 251, "x1": 1447, "y0": 992, "y1": 1041, "bl": 1036, "conf": 94.4, "row": 13, "kind": "body"}, {"text": "führe sie heraus mit Menschenhand! Ich wache; die Zauber¬", "x0": 250, "x1": 1446, "y0": 1051, "y1": 1099, "bl": 1097, "conf": 93.9, "row": 14, "kind": "body"}, {"text": "pferde sind bereit, ich entführe euch. Das vermag ich.", "x0": 249, "x1": 1366, "y0": 1109, "y1": 1158, "bl": 1156, "conf": 93.2, "row": 15, "kind": "body"}, {"text": "Faust.", "x0": 784, "x1": 908, "y0": 1187, "y1": 1231, "bl": 1231, "conf": 91.2, "row": 16, "kind": "body"}, {"text": "Auf und davon!", "x0": 328, "x1": 652, "y0": 1245, "y1": 1290, "bl": 1283, "conf": 96.6, "row": 17, "kind": "body"}, {"text": "Nacht.", "x0": 780, "x1": 911, "y0": 1512, "y1": 1556, "bl": 1556, "conf": 96.5, "row": 18, "kind": "body"}, {"text": "Offen Feld.", "x0": 707, "x1": 980, "y0": 1617, "y1": 1661, "bl": 1660, "conf": 95.7, "row": 19, "kind": "body"}, {"text": "Faust, Mephistopheles auf schwarzen Pferden daherbrausend—", "x0": 307, "x1": 1385, "y0": 1720, "y1": 1759, "bl": 1755, "conf": 91.6, "row": 20, "kind": "body"}, {"text": "Faust.", "x0": 783, "x1": 907, "y0": 1819, "y1": 1863, "bl": 1863, "conf": 90.8, "row": 21, "kind": "body"}, {"text": "Was weben die dort um den Rabenstein?", "x0": 247, "x1": 1093, "y0": 1879, "y1": 1924, "bl": 1921, "conf": 95.4, "row": 22, "kind": "body"}, {"text": "Mephistopheles.", "x0": 668, "x1": 1023, "y0": 1957, "y1": 2003, "bl": 2003, "conf": 87.4, "row": 23, "kind": "body"}, {"text": "Weiß nicht, was sie kochen und schaffen.", "x0": 247, "x1": 1058, "y0": 2020, "y1": 2070, "bl": 2066, "conf": 94.2, "row": 24, "kind": "body"}, {"text": "Faust.", "x0": 778, "x1": 900, "y0": 2099, "y1": 2141, "bl": 2141, "conf": 62.6, "row": 25, "kind": "body"}, {"text": "Schweben auf, schweben ab, neigen sich, beugen sich—", "x0": 248, "x1": 1329, "y0": 2157, "y1": 2210, "bl": 2207, "conf": 92.6, "row": 26, "kind": "body"}, {"text": "Mephistopheles.", "x0": 669, "x1": 1022, "y0": 2238, "y1": 2283, "bl": 2283, "conf": 84.5, "row": 27, "kind": "body"}, {"text": "Eine Hexenzunft.", "x0": 247, "x1": 575, "y0": 2296, "y1": 2345, "bl": 2341, "conf": 91.3, "row": 28, "kind": "body"}]}}